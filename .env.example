# TOKEN2049 meeting form (src/app/api/token2049/meeting/route.ts).
# Copy to .env.local for local runs; set the same names in the hosting
# dashboard for production. Without the first two the form still works: it
# opens the visitor's mail app instead of sending automatically.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender. The domain must be verified in Resend (DNS records), e.g.
# "HashX Labs <events@hashxlabs.com>"
MAIL_FROM=

# Who gets the request. Optional; defaults to info@hashxlabs.com.
# Comma-separated for several people.
# MEETING_NOTIFY_TO=info@hashxlabs.com
